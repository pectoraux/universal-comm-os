// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A Communication Bundle held in a node's DTN store-and-forward queue.
/// (ARCH-003, Protocol §10, ROADMAP P3.1)
model StoredBundle {
  // bundle_id is the canonical UUID assigned by the originating node.
  bundle_id      String   @id
  // Owning node (which DTN store this row belongs to).
  node_id        String
  // Next hop the bundle should be forwarded to (opaque node id).
  next_hop       String
  // Serialized CommunicationBundle (canonical JSON of the envelope; payload stays
  // opaque base64url). We do NOT store plaintext.
  bundle_json    String
  // Bundle priority, denormalized for queue ordering.
  priority       String
  // Bundle expires_at (ms epoch), denormalized for the TTL sweeper.
  expires_at     Int
  // When the bundle was queued at this node.
  queued_at      Int      @default(0)
  // Delivery state at this node, denormalized for diagnostics.
  state          String   @default("QUEUED")

  @@index([node_id, queued_at])
  @@index([expires_at])
  @@index([node_id, state])
}

/// Per-node "have I already seen this bundle" index. Implements Protocol §10
/// deduplication across restarts. Survives process restarts.
model ReceivedBundle {
  // bundle_id is the canonical UUID.
  bundle_id    String
  // The node that received it.
  node_id      String
  // When the bundle was first received at this node.
  received_at  Int     @default(0)
  // The node the bundle was received from (for forensic / observability).
  from_node_id String?

  @@id([node_id, bundle_id])
  @@index([received_at])
}

/// Delivery state event log per bundle, per node. Survives restarts.
/// (ARCH-012 explicit multi-state machine, in persisted form.)
model DeliveryEvent {
  id           String   @id @default(cuid())
  bundle_id    String
  node_id      String
  from_state   String?
  to_state     String
  ts           Int
  transport    String?
  note         String?

  @@index([bundle_id, node_id, ts])
  @@index([node_id, ts])
}
