// Prisma schema for Universal Communication OS
// PostgreSQL on Neon for production, SQLite for local dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentication (NextAuth.js) ───────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  password     String?
  role         String   @default("user") // "user" | "admin" | "demo"
  waitlist     Boolean  @default(false)
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  memberships  UserOrganization[]

  @@map("users")
}

// S0.1: Organization — first-class resource ownership entity.
model Organization {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  createdAt   DateTime @default(now())

  members     UserOrganization[]
  nodeOwnerships NodeOwnership[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

// S0.1: UserOrganization join — maps users to organizations with roles.
model UserOrganization {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  role            String   @default("member") // "member" | "admin" | "owner"
  createdAt       DateTime @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

// S0.1: NodeOwnership — maps CommOS nodes to organizations.
// A node belongs to exactly one organization.
model NodeOwnership {
  id              String   @id @default(cuid())
  nodeId          String   @unique // e.g. "alice", "bob", "relay", "gateway"
  organizationId  String
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("node_ownerships")
}

// S0.1: AuditEvent — every authorized operation is logged.
model AuditEvent {
  id              String   @id @default(cuid())
  actorEmail      String
  actorRole       String
  action          String   // e.g. "dispatch", "getInbox", "resetNetwork"
  resourceType    String   // "node", "bundle", "conversation", "network"
  resourceId      String?
  organizationId  String?
  outcome         String   @default("allowed") // "allowed" | "denied"
  reason          String?
  ts              DateTime @default(now())

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorEmail, ts])
  @@index([action, ts])
  @@index([organizationId, ts])
  @@map("audit_events")
}

// S0.2: ChannelVerificationChallenge — for real channel-ownership verification.
model ChannelVerificationChallenge {
  id              String   @id @default(cuid())
  node_id         String
  channel         String   // EMAIL, SMS, WHATSAPP, etc.
  channel_id      String   // e.g. bob@example.com
  // S0.2.1-2: Hash of the challenge code (SHA-256). Never store plaintext.
  challenge_hash  String
  status          String   @default("pending") // pending | verified | expired | revoked
  // S0.2.1-3: The link's verification state in the IdentityGraph.
  link_state      String   @default("ASSERTED") // ASSERTED | VERIFIED | EXPIRED | REVOKED
  created_at      DateTime @default(now())
  expires_at      DateTime
  verified_at     DateTime?
  organization_id String?

  @@unique([node_id, channel, channel_id])
  @@map("channel_verification_challenges")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String  @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Communication OS Protocol ─────────────────────────────────────────

model StoredBundle {
  bundle_id   String   @id
  node_id     String
  next_hop    String
  bundle_json String
  priority    String
  expires_at  Int
  queued_at   Int      @default(0)
  state       String   @default("QUEUED")

  @@index([node_id, queued_at])
  @@index([expires_at])
  @@index([node_id, state])
  @@map("stored_bundles")
}

model ReceivedBundle {
  bundle_id   String
  node_id     String
  received_at Int     @default(0)
  from_node_id String?

  @@id([node_id, bundle_id])
  @@index([received_at])
  @@map("received_bundles")
}

model DeliveryEvent {
  id          String   @id @default(cuid())
  bundle_id   String
  node_id     String
  from_state  String?
  to_state    String
  ts          Int
  transport   String?
  note        String?

  @@index([bundle_id, node_id, ts])
  @@index([node_id, ts])
  @@map("delivery_events")
}

// ─── Waitlist ──────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())
  approvedAt DateTime?
  approvedBy String?

  @@map("waitlist_entries")
}
