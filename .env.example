# Universal Communication OS — Environment Variables
#
# Copy this file to .env and fill in your values.
# Do NOT commit .env — it is gitignored.
#
# PostgreSQL is the canonical database. SQLite is forbidden.
# See: tests/architecture/s026a-postgres-provider.test.ts

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/commos_dev
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
